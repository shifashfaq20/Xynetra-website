# ── Supabase (auth + database) ─────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── Paddle (international rail — US/UK card subscriptions) ──────────────────
# Sandbox until your Paddle account is approved. Values start as placeholders.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=[PADDLE_CLIENT_TOKEN]
NEXT_PUBLIC_PADDLE_PRICE_ID=[PADDLE_PRICE_ID]

# ── Pakistan rail (manual payment details shown on the billing page) ───────
PK_BANK_ACCOUNT_DETAILS=[BANK_ACCOUNT_DETAILS]
PK_EASYPAISA_NUMBER=[EASYPAISA_NUMBER]
PK_JAZZCASH_NUMBER=[JAZZCASH_NUMBER]
